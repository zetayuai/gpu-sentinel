# LLM (OpenAI-compatible). AkashML: base_url https://api.akashml.com/v1 + their model id.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
# Senso ground truth (optional; local playbooks/ used as fallback)
SENSO_API_KEY=
# Copilot backend: clickhouse (real-time) | trino (lakehouse)
COPILOT_BACKEND=clickhouse
